DATABASE_URL=postgresql://assessment:assessment@localhost:5432/assessment
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_ENABLED=false

# Local email links are printed in the Django terminal. Set the SMTP backend in deployment.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Game Store <noreply@example.com>
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

AUTH_THROTTLE_RATE=20/min
EMAIL_IP_THROTTLE_RATE=20/hour
EMAIL_ADDRESS_THROTTLE_RATE=3/hour
# Shared Redis cache required for throttling across multiple application workers.
# CACHE_URL=redis://localhost:6379/1
